---
import { Font } from "astro:assets";
import { siteMeta, siteUrl } from "@/lib/siteMeta";

export interface OpenGraphArticle {
  url: string;
  publishedTime: Date;
  tags?: string[];
  imageAlt: string;
}

interface Props {
  title?: string;
  description?: string;
  article?: OpenGraphArticle;
}

const { title, description = siteMeta.description, article } = Astro.props;

const absolute = (path: string) => new URL(path, siteUrl).toString();

const pageTitle = title ? `${title} – ${siteMeta.author}` : siteMeta.title;
// Pages without their own Open Graph data inherit the site-wide values, like Next.js metadata merging did.
const ogTitle = article ? title : siteMeta.title;
const ogDescription = article ? description : siteMeta.description;
const ogImage = absolute(siteMeta.ogImage);
---

<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1" />
<title>{pageTitle}</title>
<meta name="description" content={description} />

<link rel="icon" href="/favicon.ico" />
<link rel="shortcut icon" href="/favicon.ico" />
<link rel="apple-touch-icon" href="/apple-touch-icon.png" />
<link rel="alternate" type="application/rss+xml" title={siteMeta.feed.title} href={absolute(siteMeta.feed.feedPath)} />

<meta property="og:title" content={ogTitle} />
<meta property="og:description" content={ogDescription} />
<meta property="og:url" content={article ? article.url : siteUrl} />
<meta property="og:site_name" content={siteMeta.author} />
{!article && <meta property="og:locale" content={siteMeta.locale} />}
<meta property="og:image" content={ogImage} />
<meta property="og:image:width" content={String(siteMeta.ogImageWidth)} />
<meta property="og:image:height" content={String(siteMeta.ogImageHeight)} />
<meta property="og:image:alt" content={article ? article.imageAlt : siteMeta.author} />
<meta property="og:type" content={article ? "article" : "website"} />
{article && <meta property="article:published_time" content={article.publishedTime.toISOString()} />}
{article?.tags?.map((tag) => <meta property="article:tag" content={tag} />)}

<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={ogTitle} />
<meta name="twitter:description" content={ogDescription} />
<meta name="twitter:image" content={ogImage} />

<Font cssVariable="--font-noto-serif-display" preload />
