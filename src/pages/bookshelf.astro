---
import BaseLayout from "@/layouts/BaseLayout.astro";
import PageHeader from "@/partials/PageHeader.astro";
import BookCover from "@/components/BookCover.astro";
import { getAllContent } from "@/lib/content";
import type { BookMeta } from "@/lib/types";

const books = await getAllContent("books");
const booksByYear = books.reduce<Record<string, typeof books>>((acc, book) => {
  const meta = book.meta as unknown as BookMeta;
  const year = meta.yearRead ?? new Date().getFullYear();
  const yearKey = Number.isFinite(year) ? String(year) : "Unknown";

  if (!acc[yearKey]) {
    acc[yearKey] = [];
  }

  acc[yearKey].push(book);
  return acc;
}, {});

const years = Object.keys(booksByYear).sort((a, b) => {
  if (a === "Unknown") return 1;
  if (b === "Unknown") return -1;
  return Number(b) - Number(a);
});

const totalPages = books.reduce((acc, book) => acc + ((book.meta as unknown as BookMeta).pageCount ?? 0), 0);
---

<BaseLayout title="Bookshelf">
  <article class="c-page c-page--single c-page--bookshelf u-grid">
    <PageHeader
      title="Bookshelf"
      summary="A list of books I've read."
    />

    <div class="c-page__body">
      {years.map((year) => (
        <section>
          <h2 class="c-section__title">{year} ({booksByYear[year].length})</h2>

          <ul class="c-book-list">
            {booksByYear[year].map((book) => {
              const meta = book.meta as unknown as BookMeta;
              return (
                <li>
                  <BookCover
                    isbn={meta.isbn}
                    title={meta.title}
                    author={meta.author}
                    yearPublished={meta.yearPublished}
                  />
                </li>
              );
            })}
          </ul>
        </section>
      ))}

      <section>
        <h2 class="c-section__title">Some Stats</h2>

        <ul class="c-books-stats">
          <li>
            <p class="c-books-stats__label">Total books read</p>
            <p class="c-books-stats__value">{books.length}</p>
          </li>
          <li>
            <p class="c-books-stats__label">Total pages read</p>
            <p class="c-books-stats__value">{totalPages}</p>
          </li>
          <li>
            <p class="c-books-stats__label">Time spent reading</p>
            <p class="c-books-stats__value">1.852 hours</p>
          </li>
        </ul>
      </section>
    </div>
  </article>
</BaseLayout>
